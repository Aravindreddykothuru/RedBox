# Copy to backend/.env (git-ignored) and fill in. Every setting is optional except where noted.

# Accounts: "local" (default; email + password accounts in this API), "supabase", or "dev" (tests only).
REDBOX_AUTH_MODE=local

# Required in production for "local" accounts: the key that signs login tokens. Without it the API makes
# a random one at startup, and everyone is signed out whenever the API restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
REDBOX_JWT_SECRET=

# Accounts that may open the live-metrics page (/ops), as a JSON list.
REDBOX_ADMIN_EMAILS=[]

# Database: a SQLite file in data/ by default; Postgres in production, e.g.
#   postgresql+psycopg://user:password@host:5432/dbname
# REDBOX_DATABASE_URL=

# Model bundle: data/bundles/ml-32m once exported, else data/bundles/ml-1m.
# REDBOX_BUNDLE_DIR=

# Online A/B test on the top picks (set REDBOX_AB_EXPERIMENT= to switch it off).
# REDBOX_AB_EXPERIMENT=topPicksDiversity-1
# REDBOX_AB_VARIANTS={"control": 0.0, "diverse": 0.2}

# The web app's address (CORS), as a JSON list.
# REDBOX_CORS_ORIGINS=["http://localhost:3000"]
